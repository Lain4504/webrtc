# Server LiveKit API URL (backend server that provides LiveKit APIs)
NEXT_PUBLIC_SERVER_LIVEKIT_URL=http://localhost:3001

# Recording endpoint - relative path to API routes for recording
# This enables recording feature in SettingsMenu
NEXT_PUBLIC_LK_RECORD_ENDPOINT=/api/record

# Optional: Show settings menu (default: false if not set)
# NEXT_PUBLIC_SHOW_SETTINGS_MENU=true

# Legacy environment variables (deprecated, kept for backward compatibility)
# NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
# NEXT_PUBLIC_LIVEKIT_WS_URL=wss://wajlc-uaiihqzo.livekit.cloud
